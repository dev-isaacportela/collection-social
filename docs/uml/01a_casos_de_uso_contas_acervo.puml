@startuml
!include estilo.iuml
left to right direction
skinparam defaultFontSize 13

actor "Visitante" as Visitante
actor "Colecionador" as Colecionador
actor "Serviço de Email" as Email <<sistema>>

Visitante <|-- Colecionador

rectangle "Collection Social" {
  package "Contas e Acesso" {
    usecase "UC01 Cadastrar conta" as UC01
    usecase "UC02 Confirmar email" as UC02
    usecase "UC03 Autenticar usuário" as UC03
    usecase "UC04 Recuperar senha" as UC04
    usecase "UC11 Gerenciar dados pessoais" as UC11
  }
  package "Descoberta" {
    usecase "UC05 Visualizar conteúdo público" as UC05
    usecase "UC06 Buscar e explorar comunidade" as UC06
  }
  package "Acervo" {
    usecase "UC07 Gerenciar perfil" as UC07
    usecase "UC08 Gerenciar coleções" as UC08
    usecase "UC09 Gerenciar itens" as UC09
    usecase "UC10 Buscar no acervo" as UC10
  }
}

Visitante --> UC01
Visitante --> UC03
Visitante --> UC05
Visitante --> UC06

Colecionador --> UC07
Colecionador --> UC08
Colecionador --> UC09
Colecionador --> UC10
Colecionador --> UC11

UC01 ..> UC02 : <<include>>
UC04 ..> UC03 : <<extend>>

UC02 --> Email
UC04 --> Email
@enduml
