@startuml
!include estilo.iuml
skinparam defaultFontSize 13

|Proponente|
start
:Escolher itens disponíveis do destinatário;
:Selecionar itens próprios disponíveis;
:Enviar proposta;
|Sistema|
if (Proposta atende RN25?) then (não)
  :Informar o motivo;
  |Proponente|
  stop
else (sim)
endif
repeat
  |Sistema|
  :Registrar proposta como pendente;
  :Notificar a outra parte;
  |Destinatário|
  :Analisar proposta;
repeat while (Fazer contraproposta?) is (sim) not (não)
|Sistema|
switch (Resposta)
case (recusar)
  :Registrar recusa e notificar;
  stop
case (sem resposta em 7 dias)
  :Expirar proposta e notificar;
  stop
case (aceitar)
  :Reservar itens envolvidos;
endswitch
fork
  |Proponente|
  :Enviar seus itens;
  :Confirmar recebimento;
fork again
  |Destinatário|
  :Enviar seus itens;
  :Confirmar recebimento;
end fork
|Sistema|
:Concluir troca;
:Retirar itens trocados da lista de disponíveis;
:Liberar avaliações;
fork
  |Proponente|
  :Avaliar destinatário;
fork again
  |Destinatário|
  :Avaliar proponente;
end fork
|Sistema|
:Atualizar reputação;
stop
@enduml
