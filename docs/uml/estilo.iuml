skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1.1
skinparam roundCorner 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam componentStyle uml1
skinparam class {
  BackgroundColor #F7F9FC
  BorderColor #2F4A6D
  HeaderBackgroundColor #DCE6F2
}
skinparam object {
  BackgroundColor #F7F9FC
  BorderColor #2F4A6D
}
skinparam usecase {
  BackgroundColor #F7F9FC
  BorderColor #2F4A6D
}
skinparam actor {
  BorderColor #2F4A6D
  BackgroundColor #DCE6F2
}
skinparam activity {
  BackgroundColor #F7F9FC
  BorderColor #2F4A6D
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #9A7B2F
}
skinparam state {
  BackgroundColor #F7F9FC
  BorderColor #2F4A6D
}
skinparam component {
  BackgroundColor #F7F9FC
  BorderColor #2F4A6D
}
skinparam sequence {
  LifeLineBorderColor #2F4A6D
  ParticipantBackgroundColor #DCE6F2
  ParticipantBorderColor #2F4A6D
  ActorBackgroundColor #DCE6F2
  ActorBorderColor #2F4A6D
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #9A7B2F
}
skinparam swimlane {
  BorderColor #2F4A6D
  TitleFontStyle bold
}
