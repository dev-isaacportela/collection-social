@startuml
!include estilo.iuml
hide empty members
skinparam nodesep 40
skinparam ranksep 60

class Usuario {
  UUID id
  String email
  String nomeUsuario
  String hashSenha
  DateTime emailConfirmadoEm
  SituacaoConta situacao
  Boolean confirmarEmail(String token)
  Boolean autenticar(String senha)
  void solicitarExclusao()
}

class Moderador {
  void decidirDenuncia(Denuncia denuncia, String decisao)
}

class Perfil {
  String nomeExibicao
  String bio
  String cidade
  String uf
  void atualizar(DadosPerfil dados)
}

class Categoria {
  String nome
  String slug
}

class Colecao {
  UUID id
  String nome
  String descricao
  Visibilidade visibilidade
  Integer posicao
  Boolean estaPublica()
  void reordenar(Integer novaPosicao)
}

class Item {
  UUID id
  String nome
  String descricao
  Integer ano
  EstadoConservacao estado
  String grau
  Integer quantidade
  Boolean disponivelParaTroca
  void moverPara(Colecao destino)
  void marcarDisponivel(Boolean valor)
}

class DadosPrivadosItem {
  Decimal valorPago
  Decimal valorEstimado
  Date dataAquisicao
  String observacoes
}

class Foto {
  String chaveOriginal
  Integer posicao
  SituacaoFoto situacao
  void processar()
}

class Tag {
  String nome
}

enum Visibilidade {
  Publica
  Privada
}

enum EstadoConservacao {
  NovoLacrado
  Excelente
  MuitoBom
  Bom
  Regular
  Ruim
}

enum SituacaoConta {
  Ativa
  Suspensa
  EmExclusao
}

enum SituacaoFoto {
  EmProcessamento
  Pronta
  Rejeitada
}

Usuario <|-- Moderador
Usuario "1" *-- "1" Perfil
Perfil "0..*" --> "0..*" Categoria : interesses
Usuario "1" *-- "0..*" Colecao : possui
Colecao "0..*" --> "1" Categoria
Colecao "1" *-- "0..*" Item : contém
Item "1" *-- "1..10" Foto
Item "1" *-- "0..1" DadosPrivadosItem
Item "0..*" o-- "0..*" Tag

Usuario ..> SituacaoConta
Colecao ..> Visibilidade
Item ..> EstadoConservacao
Foto ..> SituacaoFoto
@enduml
